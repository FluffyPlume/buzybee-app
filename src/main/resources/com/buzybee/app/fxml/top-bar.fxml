<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox alignment="CENTER_LEFT" prefHeight="37.0" styleClass="top-bar" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buzybee.app.controller.TopBarController">
    <padding>
        <Insets left="0.0" right="14.0" />
    </padding>

    <HBox alignment="CENTER" prefWidth="36.0" minWidth="36.0" maxWidth="36.0" HBox.hgrow="NEVER">
        <ImageView fitHeight="32.0" fitWidth="32.0" preserveRatio="true" styleClass="brand-bee-logo">
            <image>
                <Image url="@../images/Bee.png" />
            </image>
        </ImageView>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="6.0" HBox.hgrow="NEVER">
        <Label styleClass="brand-title" text="BuzyBee" />
    </HBox>
    <Region HBox.hgrow="ALWAYS" />

    <HBox alignment="CENTER" prefWidth="170.0" spacing="12.0" styleClass="top-actions" HBox.hgrow="NEVER">
        <HBox alignment="CENTER" spacing="0.0" styleClass="theme-toggle">
            <Button fx:id="btnDarkMode" focusTraversable="false" mnemonicParsing="false" onAction="#onDarkMode" styleClass="theme-btn">
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/dark.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnLightMode" focusTraversable="false" mnemonicParsing="false" onAction="#onLightMode">
                <styleClass>
                    <String fx:value="theme-btn" />
                    <String fx:value="theme-btn-active" />
                </styleClass>
                <graphic>
                    <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/light.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <Button fx:id="btnNotification" focusTraversable="false" mnemonicParsing="false" onAction="#onTopNotification" styleClass="top-action-btn">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/notification.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="btnUser" focusTraversable="false" mnemonicParsing="false" onAction="#onTopUser" styleClass="top-action-btn">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/user.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
</HBox>
