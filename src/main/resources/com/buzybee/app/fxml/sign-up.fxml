<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="383.0" prefWidth="682.0" stylesheets="@../css/sign-up.css"
            styleClass="signin-root" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.buzybee.app.controller.SignUpController">
    <children>
        <ImageView fitHeight="383.0" fitWidth="682.0" pickOnBounds="true">
            <image>
                <Image url="@../images/pattern%20bg.png" />
            </image>
        </ImageView>

        <AnchorPane fx:id="brandPanel" id="brandPanel" prefHeight="383.0" prefWidth="354.0" styleClass="brand-panel-left">
            <children>
                <Label alignment="CENTER" layoutX="15.0" layoutY="100.0" prefWidth="300.0" text="WELCOME TO"
                       textAlignment="CENTER" styleClass="welcome-title" />
                <Label alignment="CENTER" layoutY="116.0" prefWidth="354.0" text="BuzyBee!"
                       textAlignment="CENTER" styleClass="welcome-brand-title" />
                <Label alignment="CENTER" layoutY="239.0" prefWidth="354.0"
                       text="Sign In to enjoy the app!" textAlignment="CENTER" styleClass="signin-prompt" />
                <Button layoutX="78.0" layoutY="264.0" mnemonicParsing="false" onAction="#handleSignIn"
                        prefHeight="45.0" prefWidth="198.0" text="Sign In!" styleClass="signin-switch-button" />
            </children>
        </AnchorPane>

        <AnchorPane fx:id="formPane" id="formPane" layoutX="396.0" layoutY="14.0" prefHeight="328.0" prefWidth="260.0">
            <children>
                <Label layoutX="3.0" layoutY="-2.0" text="Create an account!" styleClass="signup-title" />
                <Label layoutX="7.0" layoutY="33.0" text="Register to sign in" styleClass="signup-subtitle" />

                <Label layoutX="8.0" layoutY="60.0" text="Email address" styleClass="field-label" />
                <TextField layoutX="6.0" layoutY="78.0" prefHeight="37.0" prefWidth="253.0"
                           promptText="you@example" styleClass="signin-field, email-field" />

                <Label layoutX="8.0" layoutY="117.0" text="Username" styleClass="field-label" />
                <TextField layoutX="6.0" layoutY="135.0" prefHeight="37.0" prefWidth="253.0"
                           promptText="you12345" styleClass="signin-field, email-field" />

                <Label layoutX="8.0" layoutY="174.0" text="Password" styleClass="field-label" />
                <PasswordField layoutX="6.0" layoutY="194.0" prefHeight="37.0" prefWidth="253.0"
                               promptText="●●●●●●" styleClass="signin-field, password-field" />

                <Button layoutX="6.0" layoutY="242.0" mnemonicParsing="false" onAction="#handleSignUp"
                        prefHeight="37.0" prefWidth="253.0" text="Sign Up" styleClass="primary-button" />

                <Line endX="94.0" layoutX="7.0" layoutY="296.0" startX="0.0" styleClass="or-line" />
                <Label layoutX="126.0" layoutY="286.0" text="or" styleClass="or-label" />
                <Line endX="94.0" layoutX="161.0" layoutY="296.0" startX="0.0" styleClass="or-line" />
                <Button layoutX="6.0" layoutY="307.0" mnemonicParsing="false" onAction="#handleGoogleSignUp"
                        prefHeight="36.0" prefWidth="253.0" text="Continue with Google" styleClass="google-button">
                    <graphic>
                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/Google%20Logo.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Label fx:id="statusLabel" layoutX="6.0" layoutY="344.0" prefWidth="253.0" text="" styleClass="status-label" />
            </children>
        </AnchorPane>

        <ImageView fx:id="beeImage" id="beeImage" fitHeight="142.0" fitWidth="175.0" layoutX="257.0" layoutY="1.0" preserveRatio="true" scaleX="-1.0">
            <image>
                <Image url="@../images/Bee.png" />
            </image>
        </ImageView>
    </children>
</AnchorPane>
