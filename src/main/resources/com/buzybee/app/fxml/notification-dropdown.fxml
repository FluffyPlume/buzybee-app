<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="notification-popup-root" stylesheets="@../css/notification-dropdown.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buzybee.app.controller.NotificationDropdownController">
    <Pane styleClass="notification-pointer" StackPane.alignment="TOP_CENTER" />
    <VBox maxWidth="336.0" minWidth="336.0" prefWidth="336.0" styleClass="notification-dropdown">
        <StackPane.margin>
            <Insets top="20.0" />
        </StackPane.margin>
        <Label alignment="CENTER" maxWidth="Infinity" styleClass="notification-heading" text="Notifications" />
        <VBox fx:id="notificationList" spacing="13.0" styleClass="notification-list" />
    </VBox>
</StackPane>
