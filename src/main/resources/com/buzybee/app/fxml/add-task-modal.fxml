<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox prefWidth="400.0" spacing="20.0" style="-fx-background-color: #FAEEDA;" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buzybee.app.controller.AddTaskController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <Label fx:id="lblModalTitle" text="Create New Task" textFill="#483521">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>

    <Label fx:id="lblError" textFill="#D32F2F" wrapText="true">
        <font><Font size="13.0" /></font>
    </Label>

    <GridPane hgap="12.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints minWidth="130.0" prefWidth="135.0" halignment="RIGHT" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" />
        </columnConstraints>

        <children>
            <Label text="Task Name:" textFill="#483521" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <font><Font name="System Bold" size="14.0" /></font>
            </Label>
            <TextField fx:id="txtName" promptText="e.g. Math Homework" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="0" />

            <Label text="Deadline:" textFill="#483521" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <font><Font name="System Bold" size="14.0" /></font>
            </Label>
            <DatePicker fx:id="dpDeadline" prefWidth="250.0" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Est. Time (hrs):" textFill