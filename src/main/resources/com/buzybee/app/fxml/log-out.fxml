<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="logout-overlay" stylesheets="@../css/log-out.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buzybee.app.controller.LogoutController">
    <padding>
        <Insets bottom="34.0" left="34.0" right="34.0" top="34.0" />
    </padding>

    <VBox alignment="CENTER" maxWidth="440.0" minWidth="440.0" spacing="16.0" styleClass="logout-panel">
        <padding>
            <Insets bottom="34.0" left="34.0" right="34.0" top="34.0" />
        </padding>

        <ImageView fitHeight="86.0" fitWidth="86.0" preserveRatio="true" styleClass="logout-bee">
            <image>
                <Image url="@../images/Bee.png" />
            </image>
        </ImageView>

        <Label styleClass="logout-title" text="Are you sure you want to log out?" textAlignment="CENTER" wrapText="true" />

        <HBox alignment="CENTER" spacing="14.0">
            <padding>
                <Insets top="6.0" />
            </padding>
            <Button fx:id="btnCancel" mnemonicParsing="false" onAction="#onCancel" styleClass="logout-cancel-btn" text="Stay" />
            <Button fx:id="btnConfirm" mnemonicParsing="false" onAction="#onConfirmLogout" styleClass="logout-confirm-btn" text="Log Out" />
        </HBox>
    </VBox>
</StackPane>
