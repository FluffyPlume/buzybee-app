<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefWidth="36.0" spacing="12.0" styleClass="side-rail" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buzybee.app.controller.SideMenuController">
    <padding>
        <Insets top="10.0" />
    </padding>

    <Button fx:id="btnDashboard" onAction="#onNavDashboard" styleClass="rail-btn">
        <graphic>
            <ImageView fitHeight="19.0" fitWidth="19.0" preserveRatio="true">
                <image>
                    <Image url="@../images/dashboard.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Button fx:id="btnCalendar" onAction="#onNavCalendar" styleClass="rail-btn">
        <graphic>
            <ImageView fitHeight="21.0" fitWidth="21.0" preserveRatio="true">
                <image>
                    <Image url="@../images/calendar.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Button fx:id="btnTasks" onAction="#onNavTasks" styleClass="rail-btn">
        <graphic>
            <ImageView fitHeight="21.0" fitWidth="21.0" preserveRatio="true">
                <image>
                    <Image url="@../images/task.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Button fx:id="btnAnalytics" onAction="#onNavAnalytics" styleClass="rail-btn">
        <graphic>
            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                <image>
                    <Image url="@../images/analytics.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Region maxWidth="40.0" prefHeight="1.0" styleClass="rail-divider" />

    <Button fx:id="btnSettings" onAction="#onNavSettings" styleClass="rail-btn">
        <graphic>
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                <image>
                    <Image url="@../images/settings.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

    <Region VBox.vgrow="ALWAYS" />

    <VBox alignment="CENTER" styleClass="logout-slot">
        <Button fx:id="btnLogout" onAction="#onNavLogout" styleClass="rail-btn logout-btn">
            <graphic>
                <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/logout.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </VBox>
</VBox>
