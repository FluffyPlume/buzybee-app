<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.buzybee.app.controller.DashboardController"
            prefWidth="622.0" prefHeight="348.0"
            minWidth="622.0" minHeight="348.0"
            styleClass="dashboard-root"
            stylesheets="@../css/dashboard.css">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="37.0" styleClass="top-bar">
            <padding>
                <Insets left="45.0" right="8.0"/>
            </padding>

            <Label text="BuzyBee" styleClass="brand-title"/>
            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="8.0" styleClass="top-actions">
                <HBox alignment="CENTER" spacing="1.0" styleClass="theme-toggle">
                    <StackPane styleClass="top-icon-wrap dark-icon-wrap">
                        <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/dark.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <StackPane styleClass="top-icon-wrap">
                        <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/light.png"/>
                            </image>
                        </ImageView>
                    </StackPane>
                </HBox>

                <StackPane styleClass="top-icon-wrap">
                    <ImageView fitWidth="17.0" fitHeight="17.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/notification.png"/>
                        </image>
                    </ImageView>
                </StackPane>

                <StackPane styleClass="top-icon-wrap user-icon-wrap">
                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/user.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>
        </HBox>
    </top>

    <center>
        <HBox>
            <VBox prefWidth="40.0" minWidth="40.0" maxWidth="40.0" styleClass="side-rail">
                <VBox alignment="TOP_CENTER" spacing="12.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="10.0"/>
                    </padding>

                    <Button fx:id="btnDashboard" styleClass="rail-btn, rail-btn-active" onAction="#onNavDashboard">
                        <graphic>
                            <ImageView fitWidth="19.0" fitHeight="19.0" preserveRatio="true">
                                <image>
                                    <Image url="@../images/dashboard.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="btnCalendar" styleClass="rail-btn" onAction="#onNavCalendar">
                        <graphic>
                            <ImageView fitWidth="21.0" fitHeight="21.0" preserveRatio="true">
                                <image>
                                    <Image url="@../images/calendar.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="btnTasks" styleClass="rail-btn" onAction="#onNavTasks">
                        <graphic>
                            <ImageView fitWidth="21.0" fitHeight="21.0" preserveRatio="true">
                                <image>
                                    <Image url="@../images/task.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="btnAnalytics" styleClass="rail-btn" onAction="#onNavAnalytics">
                        <graphic>
                            <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                <image>
                                    <Image url="@../images/analytics.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Region prefHeight="1.0" maxWidth="40.0" styleClass="rail-divider"/>

                    <Button fx:id="btnSettings" styleClass="rail-btn" onAction="#onNavSettings">
                        <graphic>
                            <ImageView fitWidth="22.0" fitHeight="22.0" preserveRatio="true">
                                <image>
                                    <Image url="@../images/settings.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </VBox>

                <Button fx:id="btnLogout" styleClass="rail-btn logout-btn">
                    <graphic>
                        <ImageView fitWidth="22.0" fitHeight="22.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/logout.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="dashboard-canvas"/>
        </HBox>
    </center>
</BorderPane>
