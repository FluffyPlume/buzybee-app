<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="348.0" minWidth="622.0" prefHeight="348.0" prefWidth="622.0" styleClass="dashboard-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buzybee.app.controller.DashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="37.0" styleClass="top-bar">
            <padding>
                <Insets left="45.0" right="14.0" />
            </padding>

            <Label styleClass="brand-title" text="BuzyBee" HBox.hgrow="NEVER" />
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" prefWidth="80.0" spacing="12.0" styleClass="top-actions" HBox.hgrow="NEVER">
                <HBox alignment="CENTER" spacing="3.0" styleClass="theme-toggle">
                    <Button fx:id="btnDarkMode" onAction="#onDarkMode" styleClass="theme-btn">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <image>
                                    <Image url="@../images/dark.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="btnLightMode" onAction="#onLightMode" styleClass="theme-btn theme-btn-active">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <image>
                                    <Image url="@../images/light.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

                <Button fx:id="btnNotification" onAction="#onTopNotification" styleClass="top-action-btn">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/notification.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="btnUser" onAction="#onTopUser" styleClass="top-action-btn">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/user.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>
   <left>
          <VBox alignment="TOP_CENTER" prefWidth="36.0" spacing="12.0" BorderPane.alignment="CENTER">
              <padding>
                  <Insets top="10.0" />
              </padding>

              <Button fx:id="btnDashboard" onAction="#onNavDashboard" styleClass="rail-btn">
                  <graphic>
                      <ImageView fitHeight="19.0" fitWidth="19.0" preserveRatio="true">
                          <image>
                              <Image url="@../images/dashboard.png" />
                          </image>
                      </ImageView>
                  </graphic>
              </Button>

              <Button fx:id="btnCalendar" onAction="#onNavCalendar" styleClass="rail-btn">
                  <graphic>
                      <ImageView fitHeight="21.0" fitWidth="21.0" preserveRatio="true">
                          <image>
                              <Image url="@../images/calendar.png" />
                          </image>
                      </ImageView>
                  </graphic>
              </Button>

              <Button fx:id="btnTasks" onAction="#onNavTasks" styleClass="rail-btn">
                  <graphic>
                      <ImageView fitHeight="21.0" fitWidth="21.0" preserveRatio="true">
                          <image>
                              <Image url="@../images/task.png" />
                          </image>
                      </ImageView>
                  </graphic>
              </Button>

              <Button fx:id="btnAnalytics" onAction="#onNavAnalytics" styleClass="rail-btn">
                  <graphic>
                      <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                          <image>
                              <Image url="@../images/analytics.png" />
                          </image>
                      </ImageView>
                  </graphic>
              </Button>

              <Region maxWidth="40.0" prefHeight="1.0" styleClass="rail-divider" />

              <Button fx:id="btnSettings" onAction="#onNavSettings" styleClass="rail-btn">
                  <graphic>
                      <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                          <image>
                              <Image url="@../images/settings.png" />
                          </image>
                      </ImageView>
                  </graphic>
              </Button>

             <VBox alignment="CENTER" styleClass="logout-slot">
                 <Button fx:id="btnLogout" onAction="#onNavLogout" styleClass="rail-btn logout-btn">
                     <graphic>
                         <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                             <image>
                                 <Image url="@../images/logout.png" />
                             </image>
                         </ImageView>
                     </graphic>
                 </Button>
             </VBox>
          </VBox>
   </left>
   <center>

         <StackPane fx:id="contentArea" onMouseClicked="#clearTopSelection" styleClass="dashboard-canvas" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
