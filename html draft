      <span class="na">›</span>
    </div>`).join('');
}

function renderUpcoming() {
  const top=[...tasks].filter(t=>!t.done)
    .sort((a,b)=>new Date(a.due||'9999')-new Date(b.due||'9999')).slice(0,4);
