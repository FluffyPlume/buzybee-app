<!-- ═══════════════════════ JAVASCRIPT ═══════════════════════ -->
<script>

/* ══════════════════════════════════════════
   DATA STORE
══════════════════════════════════════════ */

// tasks[]: the single source of truth for all tasks
let tasks = [
  { id:1, name:"Design Packaging Concept",  tag:"Motion Design", priority:"high",   due:"2025-05-16", hours:3, progress:90,  done:false, status:"inprog" },
  { id:2, name:"Read Chapter 5 – OS Notes", tag:"Academics",     priority:"medium", due:"2025-05-17", hours:2, progress:50,  done:false, status:"todo"   },
  { id:3, name:"Submit DAA Project Draft",  tag:"DAA Project",   priority:"high",   due:"2025-05-18", hours:5, progress:10,  done:false, status:"todo"   },
  { id:4, name:"Math Problem Set 4",        tag:"Math",          priority:"low",    due:"2025-05-20", hours:1, progress:100, done:true,  status:"done"   },
  { id:5, name:"Physics Lab Report",        tag:"Physics",       priority:"medium", due:"2025-05-22", hours:3, progress:30,  done:false, status:"review" },
];

let deps         = [];      // {from:id, to:id} dependency edges
let leisure      = [        // Knapsack items
  { id:1, name:"Watch Oppenheimer",  type:"🎬", time:3, score:9 },
  { id:2, name:"Play Minecraft",     type:"🎮", time:2, score:8 },
  { id:3, name:"Read Atomic Habits", type:"📚", time:2, score:7 },
  { id:4, name:"Watch Arcane S2",    type:"🎬", time:4, score:8 },
  { id:5, name:"Morning Jog",        type:"🏃", time:1, score:6 },
];
let kSel         = new Set();   // Knapsack selected IDs
let greedySlots  = [];           // [{taskId, start:Date, end:Date}]
let nextId       = 20;

// Calendar state
let calY  = new Date().getFullYear();
let calM  = new Date().getMonth();   // 0-indexed
let weekStart = getMonday(new Date()); // Monday of current week

/* ══════════════════════════════════════════
   HELPERS
══════════════════════════════════════════ */

// isOverdue: due date has passed and task is not done
function isOverdue(t) {
  if (!t.due || t.done) return false;
  return new Date(t.due) < new Date(new Date().toDateString());
}

// fmtDate: "2025-05-16" → "May 16"
function fmtDate(s) {
  if (!s) return 'No deadline';
  return new Date(s + 'T00:00').toLocaleDateString('en-US', { month:'short', day:'numeric' });
}

// fmtTime: Date → "2:00 PM"
function fmtTime(d) { return d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'}); }

// priorityWeight: High=3, Medium=2, Low=1
function pw(p) { return p==='high'?3:p==='medium'?2:1; }

// barColor: picks progress bar color
function bc(n) { return n>=75?'var(--green)':n>=40?'var(--accent)':'var(--orange)'; }

// getMonday: returns the Monday of the week containing date d
function getMonday(d) {
  const day = d.getDay();                  // 0=Sun,1=Mon…
  const diff = (day===0) ? -6 : 1 - day;  // how many days back to Monday
  const mon = new Date(d);
  mon.setDate(d.getDate() + diff);
  mon.setHours(0,0,0,0);
  return mon;
}

// dateKey: Date → "YYYY-MM-DD" string
function dateKey(d) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

/* ══════════════════════════════════════════
   NAVIGATION
══════════════════════════════════════════ */

// nav: switches the visible page and updates tab + sidebar highlights
function nav(id, btn) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.top-tab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));

  document.getElementById('page-' + id).classList.add('active');
  if (btn) btn.classList.add('active');

  // Trigger page-specific renders
  if (id==='dashboard')  renderDash();
  if (id==='calendar')   { renderMiniCal(); renderWeek(); }
  if (id==='kanban')     renderKanban();
  if (id==='backlog')    renderLeisure();
  if (id==='topo')       refreshDepSelects();
}

/* ══════════════════════════════════════════
   DASHBOARD
══════════════════════════════════════════ */

function renderDash() {
  const total = tasks.length;
  const done  = tasks.filter(t=>t.done).length;
  const over  = tasks.filter(t=>isOverdue(t)).length;
  const hrs   = tasks.filter(t=>!t.done).reduce((s,t)=>s+t.hours,0);
  const pct   = total ? Math.round(done/total*100) : 0;

  document.getElementById('s-total').textContent = total;
  document.getElementById('s-done').textContent  = done;
  document.getElementById('s-pct').textContent   = pct + '%';
  document.getElementById('s-over').textContent  = over;
  document.getElementById('s-hrs').textContent   = hrs + 'h';
  document.getElementById('sched-badge').textContent = tasks.filter(t=>!t.done).length;

  const el = document.getElementById('dash-list');
  el.innerHTML = tasks.length ? tasks.map((t,i)=>taskCardHTML(t,i,true)).join('') :
    '<div class="empty">No tasks yet — add one!</div>';

  renderNotifs();
  renderUpcoming();
}

// taskCardHTML: returns the HTML string for one task card
function taskCardHTML(t, i, actions) {
  return `
    <div class="task-card ${isOverdue(t)?'overdue':''}" style="animation-delay:${i*.07}s">
      <div class="tc-top">
        <div>
          <div class="tc-name ${t.done?'done':''}">${t.name}</div>
          <span class="tc-tag" style="background:${tagBg(t.tag)};color:${tagFg(t.tag)}">${t.tag}</span>
        </div>
        <div class="tc-right">
          ${isOverdue(t)?'<span class="badge overdue-b">Overdue</span>':''}
          <span class="badge ${t.priority}">${cap(t.priority)}</span>
          <span class="tc-due">Due: ${fmtDate(t.due)}</span>
          ${actions?`<div class="tc-actions">
            <button class="ic-btn" onclick="markDone(${t.id})">✓</button>
            <button class="ic-btn" onclick="deleteTask(${t.id})">🗑</button>
          </div>`:''}
        </div>
      </div>
      <div class="prog-track">
        <div class="prog-fill" style="width:${t.progress}%;background:${bc(t.progress)}"></div>
      </div>
    </div>`;
}

function cap(s) { return s[0].toUpperCase()+s.slice(1); }

// Color-code task tags dynamically using a simple hash
const TAG_PALETTES = [
  {bg:'#eef0fd',fg:'#4f52d9'},{bg:'#dcfce7',fg:'#166534'},
  {bg:'#ffedd5',fg:'#9a3412'},{bg:'#f3e8ff',fg:'#6b21a8'},
  {bg:'#fce7f3',fg:'#9d174d'},{bg:'#dbeafe',fg:'#1e40af'},
  {bg:'#fef9c3',fg:'#713f12'},{bg:'#ccfbf1',fg:'#134e4a'},
];
const tagCache = {};
let tagIdx = 0;
function tagColor(tag) {
  if (!tagCache[tag]) { tagCache[tag] = TAG_PALETTES[tagIdx++ % TAG_PALETTES.length]; }
  return tagCache[tag];
}
function tagBg(tag) { return tagColor(tag).bg; }
function tagFg(tag) { return tagColor(tag).fg; }

function markDone(id) {
  const t = tasks.find(t=>t.id===id);
  if (t) { t.done=!t.done; t.status=t.done?'done':t.status==='done'?'todo':t.status; if(t.done)t.progress=100; }
  renderDash();
}
function deleteTask(id) {
  tasks=tasks.filter(t=>t.id!==id); deps=deps.filter(d=>d.from!==id&&d.to!==id);
  renderDash();
}

/* ══════════════════════════════════════════
   RIGHT PANEL
══════════════════════════════════════════ */

function renderNotifs() {
  const notifs=[];
  tasks.filter(t=>isOverdue(t)&&!t.done).forEach(t=>
    notifs.push({icon:'🔴',title:'Overdue!',msg:`"${t.name}" is past due.`,bg:'#fecaca'}));
  tasks.filter(t=>!t.due&&!t.done).forEach(t=>
