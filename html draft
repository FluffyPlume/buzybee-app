<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Buzybee</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════
   ROOT TOKENS
══════════════════════════════════════════ */
:root {
  --bg:        #f4f5fb;
  --card:      #ffffff;
  --sidebar:   #ffffff;
  --accent:    #6366f1;      /* indigo */
  --accent-lt: #eef0fd;
  --accent-dk: #4f52d9;
  --teal:      #14b8a6;
  --teal-lt:   #ccfbf1;
  --green:     #22c55e;
  --green-lt:  #dcfce7;
  --orange:    #f97316;
  --orange-lt: #ffedd5;
  --pink:      #ec4899;
  --pink-lt:   #fce7f3;
  --red:       #ef4444;
  --red-lt:    #fee2e2;
  --yellow:    #eab308;
  --yellow-lt: #fef9c3;
  --purple:    #a855f7;
  --purple-lt: #f3e8ff;
  --text:      #1e1e32;
  --text-2:    #64648a;
  --text-3:    #a0a0be;
  --border:    #ebebf5;
  --shadow-sm: 0 1px 4px rgba(99,102,241,.07);
  --shadow:    0 2px 16px rgba(99,102,241,.10);
  --shadow-lg: 0 8px 32px rgba(99,102,241,.15);
  --r:         14px;
  --r-sm:      10px;
  --r-xs:      6px;
}

*, *::before, *::after { box-sizing: border-box; margin:0; padding:0; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--text);
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  font-size: 13px;
}

/* ══════════════════════════════════════════
   TOP BAR
══════════════════════════════════════════ */
.topbar {
  height: 56px;
  background: var(--card);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 20px;
  gap: 12px;
  flex-shrink: 0;
  z-index: 20;
}

.logo {
  display: flex; align-items: center; gap: 8px;
  font-family: 'Sora', sans-serif;
  font-size: 16px; font-weight: 800;
  color: var(--accent);
  margin-right: 8px;
}
.logo-icon {
  width: 32px; height: 32px; border-radius: 9px;
  background: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; color: white;
}

/* Search bar */
.search {
  flex: 1; max-width: 360px;
  display: flex; align-items: center; gap: 8px;
  background: var(--bg);
  border: 1.5px solid var(--border);
  border-radius: 10px;
  padding: 7px 14px;
  color: var(--text-3);
  font-size: 13px;
}
.search input {
  border: none; background: transparent; outline: none;
  font-family: 'DM Sans', sans-serif; font-size: 13px;
  color: var(--text); width: 100%;
}
.search input::placeholder { color: var(--text-3); }
.kbd {
  font-size: 10px; background: var(--border);
  border-radius: 4px; padding: 2px 5px;
  color: var(--text-3); font-family: monospace;
}

.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }

/* Tab nav in topbar */
.top-tabs { display: flex; gap: 2px; }
.top-tab {
  padding: 6px 14px; border: none; border-radius: 8px;
  font-family: 'DM Sans', sans-serif; font-size: 12px; font-weight: 500;
  cursor: pointer; background: transparent; color: var(--text-2);
  transition: all .18s; white-space: nowrap;
}
.top-tab:hover  { background: var(--accent-lt); color: var(--accent); }
.top-tab.active { background: var(--accent); color: white; font-weight: 600; }

.avatar-sm {
  width: 32px; height: 32px; border-radius: 50%;
  background: var(--accent);
  color: white; font-weight: 700; font-size: 12px;
  display: flex; align-items: center; justify-content: center;
}
.notif-btn {
  width: 32px; height: 32px; border-radius: 8px; border: none;
  background: var(--bg); cursor: pointer; font-size: 16px;
  display: flex; align-items: center; justify-content: center;
  position: relative; color: var(--text-2);
}
.notif-badge {
  position: absolute; top: 4px; right: 4px;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--red); border: 2px solid white;
}

/* ══════════════════════════════════════════
   BODY LAYOUT
══════════════════════════════════════════ */
.body-wrap { display: flex; flex: 1; overflow: hidden; }

/* ── LEFT SIDEBAR ── */
.sidebar {
  width: 220px; flex-shrink: 0;
  background: var(--sidebar);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
  padding: 16px 12px;
  gap: 2px;
  overflow-y: auto;
}

.sidebar-section-label {
  font-size: 10px; font-weight: 700; letter-spacing: .8px;
  color: var(--text-3); text-transform: uppercase;
  padding: 8px 8px 4px;
  margin-top: 8px;
}

.nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 10px; border-radius: var(--r-sm);
  cursor: pointer; font-size: 13px; font-weight: 500;
  color: var(--text-2);
  transition: background .15s, color .15s;
}
.nav-item:hover  { background: var(--accent-lt); color: var(--accent); }
.nav-item.active { background: var(--accent-lt); color: var(--accent); font-weight: 600; }
.nav-icon { font-size: 16px; width: 20px; text-align: center; }
.nav-badge {
  margin-left: auto; background: var(--accent);
  color: white; font-size: 10px; font-weight: 700;
  border-radius: 20px; padding: 1px 7px; min-width: 20px; text-align: center;
}

.sidebar-footer {
  margin-top: auto; padding: 10px 8px 0;
  border-top: 1px solid var(--border);
  display: flex; align-items: center; gap: 10px;
}
.sidebar-user-name { font-size: 13px; font-weight: 600; }
.sidebar-user-email { font-size: 11px; color: var(--text-3); }

/* ── PAGES ── */
.page { display: none; flex: 1; overflow-y: auto; }
.page.active { display: flex; flex-direction: column; }

/* ══════════════════════════════════════════
   RIGHT NOTIFICATION PANEL
══════════════════════════════════════════ */
.right-panel {
  width: 260px; flex-shrink: 0;
  background: var(--card);
  border-left: 1px solid var(--border);
  display: flex; flex-direction: column;
  padding: 18px 14px; gap: 14px;
  overflow-y: auto;
}
.rp-title {
  font-family: 'Sora', sans-serif;
  font-size: 13px; font-weight: 700;
}
.rp-see-all { font-size: 11px; color: var(--accent); cursor: pointer; margin-left: auto; }

.notif-card {
  border-radius: var(--r-sm); padding: 10px 12px;
  display: flex; gap: 10px; align-items: flex-start;
  cursor: pointer; transition: transform .15s;
}
.notif-card:hover { transform: translateX(2px); }
.ni { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
.nm { font-size: 11.5px; line-height: 1.45; flex: 1; }
.nm strong { display: block; font-weight: 600; margin-bottom: 1px; }
.na { font-size: 16px; color: var(--text-3); margin-top: 2px; }

.up-row {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--bg); border-radius: var(--r-sm);
  padding: 8px 11px; margin-bottom: 6px;
  cursor: pointer; transition: background .15s;
}
.up-row:hover { background: var(--accent-lt); }
.up-name { font-size: 12px; font-weight: 500; }
.up-pill {
  font-size: 9px; font-weight: 700; color: white;
  border-radius: 20px; padding: 2px 8px;
}

/* ══════════════════════════════════════════
   SHARED CARD & SECTION STYLES
══════════════════════════════════════════ */
.page-pad { padding: 22px 24px; }

.page-title { font-family:'Sora',sans-serif; font-size:20px; font-weight:800; }
.page-sub   { font-size:12px; color:var(--text-2); margin-top:2px; }

.sec-title {
  font-family:'Sora',sans-serif; font-size:14px; font-weight:700;
  margin-bottom: 10px;
}

/* Stat cards */
.stats-grid {
  display: grid; grid-template-columns: repeat(4,1fr); gap: 12px;
  margin-bottom: 20px;
}
.stat-card {
  background: var(--card); border-radius: var(--r);
  padding: 16px 18px; box-shadow: var(--shadow-sm);
  display: flex; flex-direction: column; gap: 8px;
  animation: up .4s ease both;
}
.stat-top { display: flex; align-items: center; justify-content: space-between; }
.stat-icon {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.stat-val { font-family:'Sora',sans-serif; font-size:24px; font-weight:800; line-height:1; }
.stat-lbl { font-size:11px; color:var(--text-2); }
.stat-delta { font-size:10px; font-weight:600; }
.delta-up { color: var(--green); }

/* Task card (generic) */
.task-card {
  background: var(--card); border-radius: var(--r);
  padding: 14px 16px; box-shadow: var(--shadow-sm);
  display: flex; flex-direction: column; gap: 10px;
  animation: up .35s ease both;
  transition: transform .18s, box-shadow .18s;
  cursor: default;
}
.task-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
.task-card.overdue { border-left: 3px solid var(--red); }

.tc-top { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
.tc-name { font-size:13px; font-weight:600; line-height:1.4; }
.tc-name.done { text-decoration:line-through; color:var(--text-3); }
.tc-tag {
  display:inline-block; font-size:9px; font-weight:700; letter-spacing:.3px;
  border-radius:20px; padding:2px 9px; margin-top:4px;
}
.tc-right { display:flex; align-items:center; gap:6px; flex-shrink:0; }
.badge {
  font-size:9px; font-weight:700; color:white;
  border-radius:20px; padding:3px 9px; white-space:nowrap;
}
.badge.high   { background:var(--orange); }
.badge.medium { background:var(--purple); }
.badge.low    { background:var(--green);  }
.badge.overdue-b { background:var(--red); }
.tc-due { font-size:11px; color:var(--text-2); }
.tc-actions { display:flex; gap:4px; }
.ic-btn {
  background:none; border:none; cursor:pointer;
  font-size:14px; padding:3px 5px; border-radius:6px;
  color:var(--text-3); transition:background .15s, color .15s;
}
.ic-btn:hover { background:var(--accent-lt); color:var(--accent); }

.prog-track { background:var(--border); border-radius:99px; height:6px; overflow:hidden; }
.prog-fill  { height:100%; border-radius:99px; transition:width .6s ease; }

/* Buttons */
.btn-primary {
  display:inline-flex; align-items:center; gap:6px;
  background:var(--accent); color:white;
  border:none; border-radius:var(--r-sm);
  font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
  padding:9px 18px; cursor:pointer;
  transition:background .2s, transform .15s;
}
.btn-primary:hover { background:var(--accent-dk); transform:scale(1.02); }

.btn-ghost {
  display:inline-flex; align-items:center; gap:6px;
  background:var(--accent-lt); color:var(--accent);
  border:none; border-radius:var(--r-sm);
  font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
  padding:9px 18px; cursor:pointer;
  transition:background .2s, transform .15s;
}
.btn-ghost:hover { background:var(--accent); color:white; transform:scale(1.02); }

.algo-box {
  background:var(--accent-lt); border-radius:12px;
  padding:12px 15px; font-size:12px; color:var(--accent);
  font-weight:500; line-height:1.6;
  border-left: 3px solid var(--accent);
}
.algo-box strong { font-weight:700; }

/* ══════════════════════════════════════════
   PAGE: DASHBOARD
══════════════════════════════════════════ */
#page-dashboard .inner { padding: 22px 24px; display:flex; flex-direction:column; gap:18px; }

/* ══════════════════════════════════════════
   PAGE: CALENDAR — Weekly + Mini-month style
══════════════════════════════════════════ */
#page-calendar {
  flex-direction: row !important;
  overflow: hidden;
}

/* Left mini-calendar sidebar */
.cal-left {
  width: 240px; flex-shrink: 0;
  background: var(--card);
  border-right: 1px solid var(--border);
  padding: 20px 16px;
  display: flex; flex-direction: column; gap: 16px;
  overflow-y: auto;
}
.mini-cal-header {
  display:flex; align-items:center; justify-content:space-between;
}
.mini-cal-title { font-family:'Sora',sans-serif; font-size:14px; font-weight:700; }
.mini-nav { display:flex; gap:4px; }
.mini-nav-btn {
  border:none; background:var(--bg); border-radius:6px;
  width:26px; height:26px; cursor:pointer; font-size:13px;
  color:var(--text-2); display:flex; align-items:center; justify-content:center;
  transition:background .15s;
}
.mini-nav-btn:hover { background:var(--accent-lt); color:var(--accent); }

/* 7-col mini grid */
.mini-grid {
  display:grid; grid-template-columns:repeat(7,1fr);
  gap:2px; text-align:center;
}
.mini-dow {
  font-size:9px; font-weight:700; color:var(--text-3);
  padding:3px 0; letter-spacing:.4px;
}
.mini-day {
  font-size:11px; padding:4px 2px; border-radius:6px;
  cursor:pointer; transition:background .15s;
  color:var(--text-2);
}
.mini-day:hover { background:var(--accent-lt); color:var(--accent); }
.mini-day.other { color:var(--text-3); }
.mini-day.today {
  background:var(--accent); color:white; font-weight:700; border-radius:50%;
  width:24px; height:24px; display:flex; align-items:center; justify-content:center;
  margin:auto;
}
.mini-day.has-event { position:relative; }
.mini-day.has-event::after {
  content:''; position:absolute; bottom:1px; left:50%; transform:translateX(-50%);
  width:4px; height:4px; border-radius:50%; background:var(--accent);
}

/* Reminder card */
.reminder-card {
  background:var(--accent); border-radius:var(--r-sm);
  padding:14px; color:white;
}
.rc-label { font-size:10px; opacity:.75; margin-bottom:4px; }
.rc-title { font-size:14px; font-weight:700; margin-bottom:4px; }
.rc-time  { font-size:11px; opacity:.85; }

/* Filters */
.filter-title { font-size:12px; font-weight:700; margin-bottom:8px; }
.filter-item  { display:flex; align-items:center; gap:8px; margin-bottom:6px; font-size:12px; color:var(--text-2); }
.filter-item input[type=checkbox] { accent-color:var(--accent); }

/* Right weekly view */
.cal-right {
  flex: 1; display:flex; flex-direction:column; overflow:hidden;
}

.week-header-bar {
  padding: 16px 20px; border-bottom:1px solid var(--border);
  display:flex; align-items:center; justify-content:space-between;
  background:var(--card); flex-shrink:0;
}
.week-title { font-family:'Sora',sans-serif; font-size:16px; font-weight:700; }
.week-nav   { display:flex; align-items:center; gap:10px; }
.wn-btn {
  width:30px; height:30px; border-radius:8px; border:none;
  background:var(--bg); cursor:pointer; font-size:15px;
  display:flex; align-items:center; justify-content:center;
  color:var(--text-2); transition:background .15s;
}
.wn-btn:hover { background:var(--accent-lt); color:var(--accent); }
.view-pills { display:flex; gap:4px; }
.view-pill {
  padding:5px 12px; border:none; border-radius:6px;
  font-size:11px; font-weight:600; cursor:pointer;
  background:var(--bg); color:var(--text-2);
  transition:background .15s;
}
.view-pill.active { background:var(--accent); color:white; }

/* Weekly time grid */
.week-grid-wrap { flex:1; overflow:auto; }
.week-grid {
  display:grid;
  /* time-label col + 7 day cols */
  grid-template-columns: 56px repeat(7,1fr);
  min-width: 700px;
}

/* Day column headers */
.wg-day-header {
  padding:10px 6px; text-align:center;
  border-bottom:2px solid var(--border);
  border-right:1px solid var(--border);
  position:sticky; top:0; background:var(--card); z-index:5;
}
.wg-day-header.today-col { background:var(--accent-lt); }
.wg-dow { font-size:10px; font-weight:700; color:var(--text-3); letter-spacing:.5px; }
.wg-date {
  font-family:'Sora',sans-serif; font-size:20px; font-weight:800;
  color:var(--text); line-height:1.1; margin-top:2px;
}
.wg-day-header.today-col .wg-date { color:var(--accent); }
.wg-corner { position:sticky; top:0; background:var(--card); z-index:6; border-bottom:2px solid var(--border); }

/* Time label column */
.wg-time-label {
  padding:0 8px; text-align:right;
  font-size:10px; color:var(--text-3); font-weight:500;
  display:flex; align-items:flex-start; justify-content:flex-end;
  padding-top:2px; border-right:1px solid var(--border);
}

/* Each hour row cell */
.wg-cell {
  border-right:1px solid var(--border);
  border-bottom:1px solid #f0f0f8;
  min-height:60px; position:relative;
  padding:2px 4px;
}
.wg-cell:last-child { border-right:none; }
.wg-cell.today-col  { background:rgba(99,102,241,.025); }

/* Event chip inside a grid cell */
.wg-event {
  border-radius:8px; padding:5px 8px;
  font-size:11px; line-height:1.35;
  margin-bottom:2px; cursor:pointer;
  transition:transform .15s, box-shadow .15s;
  position:relative;
}
.wg-event:hover { transform:scale(1.02); box-shadow:var(--shadow); z-index:3; }
.wg-event-time  { font-size:10px; opacity:.75; }
.wg-event-title { font-weight:600; }

/* Event colors (one per priority/type) */
.ev-high   { background:#ffedd5; color:#9a3412; border-left:3px solid var(--orange); }
.ev-medium { background:#f3e8ff; color:#6b21a8; border-left:3px solid var(--purple); }
.ev-low    { background:#dcfce7; color:#14532d; border-left:3px solid var(--green);  }
.ev-leisure{ background:#dbeafe; color:#1e40af; border-left:3px solid #3b82f6; }
.ev-overdue{ background:#fee2e2; color:#991b1b; border-left:3px solid var(--red);    }

/* ══════════════════════════════════════════
   PAGE: KANBAN BOARD (Scheduler → Greedy)
══════════════════════════════════════════ */
#page-kanban {
  flex-direction: column !important;
  overflow: hidden;
}
.kanban-header {
  padding:18px 24px 12px; flex-shrink:0;
  display:flex; align-items:center; gap:12px;
  background:var(--card); border-bottom:1px solid var(--border);
}
.kanban-body {
  flex:1; overflow-x:auto; overflow-y:hidden;
  display:flex; gap:14px; padding:18px 20px;
  align-items:flex-start;
}
.kanban-col {
  flex-shrink:0; width:260px;
  background:var(--bg); border-radius:var(--r);
  display:flex; flex-direction:column; max-height:100%;
}
.kanban-col-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:12px 14px; border-bottom:1px solid var(--border);
  flex-shrink:0;
}
.kcol-title { font-size:12px; font-weight:700; letter-spacing:.3px; }
.kcol-count {
  font-size:11px; font-weight:700; background:var(--border);
  border-radius:20px; padding:1px 8px; color:var(--text-2);
}
.kcol-add {
  border:none; background:none; cursor:pointer;
  font-size:18px; color:var(--text-3); line-height:1;
  transition:color .15s;
}
.kcol-add:hover { color:var(--accent); }
.kanban-cards { overflow-y:auto; padding:10px 10px 10px; display:flex; flex-direction:column; gap:8px; }

/* Individual Kanban card */
.k-card {
  background:var(--card); border-radius:var(--r-sm);
  padding:12px 13px; box-shadow:var(--shadow-sm);
  animation:up .3s ease both;
  transition:transform .18s, box-shadow .18s;
  cursor:grab;
}
.k-card:hover { transform:translateY(-2px); box-shadow:var(--shadow); }
.k-tags { display:flex; gap:5px; flex-wrap:wrap; margin-bottom:7px; }
.k-tag {
  font-size:9px; font-weight:700; letter-spacing:.3px;
  border-radius:4px; padding:2px 7px;
}
.k-title { font-size:12px; font-weight:600; line-height:1.45; margin-bottom:8px; }
.k-slot  { font-size:10px; color:var(--accent); font-weight:600; margin-bottom:8px; }
.k-prog-label { display:flex; justify-content:space-between; font-size:10px; color:var(--text-3); margin-bottom:4px; }
.k-footer { display:flex; align-items:center; justify-content:space-between; margin-top:8px; }
.k-meta   { font-size:10px; color:var(--text-3); }
.k-priority-dot { width:8px; height:8px; border-radius:50%; }

/* Column accent strip (top border color) */
.col-todo      { border-top:3px solid var(--purple); }
.col-inprog    { border-top:3px solid var(--orange); }
.col-review    { border-top:3px solid var(--teal);   }
.col-done      { border-top:3px solid var(--green);  }

/* ══════════════════════════════════════════
   PAGE: BACKLOG
══════════════════════════════════════════ */
.backlog-inner { padding:22px 24px; display:flex; flex-direction:column; gap:16px; }
.ctrl-bar {
  background:var(--card); border-radius:var(--r);
  padding:15px 18px; box-shadow:var(--shadow-sm);
  display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;
}
.ctrl-group { display:flex; flex-direction:column; gap:4px; }
