function openModal()  { document.getElementById('modalOverlay').classList.add('open'); }
function closeModal() { document.getElementById('modalOverlay').classList.remove('open'); }

function addTask() {
  const name =document.getElementById('t-name').value.trim();
  const tag  =document.getElementById('t-tag').value.trim()||'General';
  const pri  =document.getElementById('t-pri').value;
  const due  =document.getElementById('t-due').value;
  const hrs  =parseInt(document.getElementById('t-hrs').value)||2;
  const prog =Math.min(100,Math.max(0,parseInt(document.getElementById('t-prog').value)||0));

  if (!name) { alert('Please enter a task name.'); return; }
  tasks.push({id:nextId++,name,tag,priority:pri,due,hours:hrs,progress:prog,done:false,status:'todo'});

  // Clear fields
  ['t-name','t-tag','t-due'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('t-hrs').value=2;
  document.getElementById('t-prog').value=0;

  closeModal();
  renderDash();
}

// Close modal on backdrop click
document.getElementById('modalOverlay').addEventListener('click',function(e){
  if(e.target===this)closeModal();
});

