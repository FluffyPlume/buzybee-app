/* ══════════════════════════════════════════
   ALGORITHM 1 — GREEDY SCHEDULER
   Sort: overdue first → earliest due → highest priority
   Assign consecutive time slots starting next hour
══════════════════════════════════════════ */

function runGreedy() {
  const pending = tasks.filter(t=>!t.done);
  greedySlots   = [];

  // Sort by: overdue flag → due date → priority weight
  const sorted = [...pending].sort((a,b)=>{
    const ao=isOverdue(a)?0:1, bo=isOverdue(b)?0:1;
    if (ao!==bo) return ao-bo;
    const dd = new Date(a.due||'9999-12-31')-new Date(b.due||'9999-12-31');
    if (dd!==0) return dd;
    return pw(b.priority)-pw(a.priority);
  });

  // Round up to next whole hour
  const now = new Date();
  now.setMinutes(0,0,0);
  now.setHours(now.getHours()+1);
  let cur = new Date(now);

  sorted.forEach(t=>{
    const end = new Date(cur.getTime() + t.hours*3600000); // hours → ms
    greedySlots.push({ taskId:t.id, start:new Date(cur), end:new Date(end) });
    cur = new Date(end.getTime() + 15*60000); // 15-min buffer
  });
}

function runGreedyAndCalendar() {
  runGreedy();
  renderWeek();
}

/* ══════════════════════════════════════════
   KANBAN BOARD (Greedy result in columns)
   Columns: Todo / In Progress / Review / Done
══════════════════════════════════════════ */

const COLS = [
  { id:'todo',   label:'Todo',        cls:'col-todo',   emptyMsg:'No pending tasks' },
  { id:'inprog', label:'In Progress', cls:'col-inprog', emptyMsg:'Nothing in progress' },
  { id:'review', label:'In Review',   cls:'col-review', emptyMsg:'Nothing in review' },
  { id:'done',   label:'Done',        cls:'col-done',   emptyMsg:'No completed tasks' },
];

function renderKanban() {
  // Re-run greedy so slots are fresh
  runGreedy();

  const body = document.getElementById('kanban-body');
  body.innerHTML = '';

  COLS.forEach(col=>{
    const colTasks = tasks.filter(t=>(t.status||'todo')===col.id);
    const slotMap  = {};
    greedySlots.forEach(s=>{ slotMap[s.taskId]=s; });

    const div = document.createElement('div');
    div.className = `kanban-col ${col.cls}`;

    // Column header
    div.innerHTML = `
      <div class="kanban-col-header">
        <span class="kcol-title">${col.label.toUpperCase()}</span>
        <span class="kcol-count">${colTasks.length}</span>
        <button class="kcol-add" onclick="openModal()">＋</button>
      </div>
      <div class="kanban-cards" id="kcol-${col.id}"></div>`;
    body.appendChild(div);

    const cardsEl = div.querySelector(`#kcol-${col.id}`);

    if (!colTasks.length) {
      cardsEl.innerHTML = `<div class="empty" style="padding:20px 0">${col.emptyMsg}</div>`;
      return;
    }

    colTasks.forEach((t,i)=>{
      const slot  = slotMap[t.id];
      const card  = document.createElement('div');
      card.className = 'k-card';
      card.style.animationDelay = i*.06+'s';

      // Priority dot color
      const dotColor = t.priority==='high'?'var(--orange)':t.priority==='medium'?'var(--purple)':'var(--green)';

      card.innerHTML = `
        <div class="k-tags">
          <span class="k-tag" style="background:${tagBg(t.tag)};color:${tagFg(t.tag)}">#${t.tag.toLowerCase().replace(/\s+/g,'')}</span>
          ${isOverdue(t)?'<span class="k-tag" style="background:#fee2e2;color:#991b1b">#overdue</span>':''}
        </div>
        <div class="k-title">${t.name}</div>
        ${slot?`<div class="k-slot">🕐 ${fmtTime(slot.start)} – ${fmtTime(slot.end)}</div>`:''}
        <div class="k-prog-label">
          <span>Progress</span><span>${t.progress}%</span>
        </div>
        <div class="prog-track">
          <div class="prog-fill" style="width:${t.progress}%;background:${bc(t.progress)}"></div>
        </div>
        <div class="k-footer">
          <span class="k-meta">Due: ${fmtDate(t.due)}</span>
          <div style="display:flex;align-items:center;gap:6px">
            <div class="k-priority-dot" style="background:${dotColor}" title="${t.priority} priority"></div>
            <!-- Move task between columns -->
            <select style="font-size:10px;border:1px solid var(--border);border-radius:6px;padding:2px 4px;background:var(--bg);color:var(--text-2);cursor:pointer;outline:none"
              onchange="moveTask(${t.id},this.value)">
              ${COLS.map(c=>`<option value="${c.id}" ${(t.status||'todo')===c.id?'selected':''}>${c.label}</option>`).join('')}
            </select>
          </div>
        </div>`;
      cardsEl.appendChild(card);
    });
  });
}

// moveTask: changes a task's status column and re-renders
function moveTask(id, status) {
  const t = tasks.find(t=>t.id===id);
  if (t) { t.status=status; t.done=(status==='done'); if(t.done)t.progress=100; }
  renderKanban();
}

/* ══════════════════════════════════════════
   ALGORITHM 2 — 0/1 KNAPSACK
══════════════════════════════════════════ */

function addLeisure() {
  const name=document.getElementById('lName').value.trim();
  const time=parseInt(document.getElementById('lTime').value);
  const score=parseInt(document.getElementById('lScore').value);
  const type=document.getElementById('lType').value;
  if (!name) { alert('Enter an item name.'); return; }
  leisure.push({id:Date.now(),name,type,time,score});
  document.getElementById('lName').value='';
  renderLeisure();
}

function runKnapsack() {
  const W=parseInt(document.getElementById('freeHrs').value);
  const n=leisure.length;
  if (!n) { alert('Add leisure items first!'); return; }

  // Build dp table: rows=items, cols=hours-capacity
  const dp=Array.from({length:n+1},()=>new Array(W+1).fill(0));
  for (let i=1;i<=n;i++) {
    const it=leisure[i-1];
    for (let w=0;w<=W;w++) {
      // Skip or include: take whichever gives more enjoyment
      dp[i][w] = it.time>w ? dp[i-1][w] : Math.max(dp[i-1][w], dp[i-1][w-it.time]+it.score);
    }
  }

  // Backtrack to find which items were selected
  kSel=new Set(); let w=W;
  for (let i=n;i>=1;i--) {
    if (dp[i][w]!==dp[i-1][w]) { kSel.add(leisure[i-1].id); w-=leisure[i-1].time; }
  }

  const totalScore=dp[n][W];
  const usedTime=leisure.filter(it=>kSel.has(it.id)).reduce((s,it)=>s+it.time,0);
  const res=document.getElementById('knapsack-result');
  res.style.display='block';
  res.innerHTML=`✅ <strong>Knapsack Result:</strong> Selected <strong>${kSel.size} items</strong>
    using <strong>${usedTime}/${W} hours</strong> → total enjoyment score <strong>${totalScore}</strong>.
    Green items are selected; faded ones don't fit.`;
  renderLeisure();
}

function renderLeisure() {
  const el=document.getElementById('leisure-list');
  if (!leisure.length) { el.innerHTML='<div class="empty">Add items above.</div>'; return; }
  el.innerHTML=leisure.map((it,i)=>{
    const sel=kSel.has(it.id);
    const cls=kSel.size>0?(sel?'sel':'skip'):'';
    return `
      <div class="l-card ${cls}" style="animation-delay:${i*.05}s">
        <div class="l-emoji">${it.type}</div>
        <div class="l-info">
          <div class="l-name">${it.name}</div>
          <div class="l-meta">⏱ ${it.time}h needed · ⭐ ${it.score}/10 enjoyment</div>
        </div>
        <div class="l-score">${it.score}</div>
        ${sel?'<span class="l-sel-badge">✓ Selected</span>':''}
        <button class="ic-btn" onclick="delLeisure(${it.id})">🗑</button>
      </div>`;
  }).join('');
}

function delLeisure(id) { leisure=leisure.filter(it=>it.id!==id); kSel.delete(id); renderLeisure(); }

/* ══════════════════════════════════════════
   ALGORITHM 3 — TOPOLOGICAL SORT (Kahn's)
══════════════════════════════════════════ */

function refreshDepSelects() {
  const opts=tasks.map(t=>`<option value="${t.id}">${t.name}</option>`).join('');
  document.getElementById('depFrom').innerHTML=opts;
  document.getElementById('depTo').innerHTML  =opts;
}

function addDep() {
  const from=parseInt(document.getElementById('depFrom').value);
  const to  =parseInt(document.getElementById('depTo').value);
  if (from===to) { alert('A task cannot depend on itself.'); return; }
  if (deps.find(d=>d.from===from&&d.to===to)) { alert('Already exists.'); return; }
  deps.push({from,to});
  const info=document.getElementById('dep-info');
  info.style.display='block';
  info.innerHTML='<strong>Dependencies:</strong><br>'+
    deps.map(d=>`→ "${tasks.find(t=>t.id===d.from)?.name}" before "${tasks.find(t=>t.id===d.to)?.name}"`).join('<br>');
}

function runTopo() {
  const el=document.getElementById('topo-out');
  if (!tasks.length) { el.innerHTML='<div class="empty">Add tasks on Dashboard first.</div>'; return; }

  // Build adjacency list (adj) and in-degree map (inDeg)
  const adj={}, inDeg={};
  tasks.forEach(t=>{ adj[t.id]=[]; inDeg[t.id]=0; });
  deps.forEach(({from,to})=>{
    if (adj[from]!==undefined&&inDeg[to]!==undefined) { adj[from].push(to); inDeg[to]++; }
  });

  // Kahn's: start with all zero-in-degree nodes
  const queue=tasks.filter(t=>inDeg[t.id]===0).map(t=>t.id);
  const order=[];
  while (queue.length) {
    const cur=queue.shift(); order.push(cur);
    // Decrement each dependent; enqueue if now zero
    adj[cur].forEach(nx=>{ inDeg[nx]--; if(inDeg[nx]===0)queue.push(nx); });
  }

  // Cycle check
  if (order.length!==tasks.length) {
    el.innerHTML=`<div class="algo-box" style="background:#fecaca;color:#991b1b;border-color:#ef4444">
      ⚠️ <strong>Cycle detected!</strong> Remove conflicting dependencies.</div>`;
    return;
  }

  el.innerHTML=`<div class="algo-box" style="margin-bottom:10px">
    ✅ <strong>Valid order found!</strong> Study in the steps below.</div>`+
  order.map((id,i)=>{
    const t=tasks.find(t=>t.id===id); if(!t) return '';
    const pre=deps.filter(d=>d.to===t.id).map(d=>tasks.find(x=>x.id===d.from)?.name).filter(Boolean);
    return `
      <div class="task-card" style="animation-delay:${i*.08}s">
        <div class="tc-top">
          <div>
            <div class="tc-name">Step ${i+1}: ${t.name}</div>
            <span class="tc-tag" style="background:${tagBg(t.tag)};color:${tagFg(t.tag)}">${t.tag}</span>
          </div>
          <div class="tc-right">
            <span class="badge ${t.priority}">${cap(t.priority)}</span>
            <span class="tc-due">Due: ${fmtDate(t.due)}</span>
          </div>
        </div>
        <div style="font-size:11px;color:var(--text-2)">
          ${pre.length?`📌 After: ${pre.map(p=>`<span style="background:var(--bg);border-radius:4px;padding:1px 7px;margin-right:4px">${p}</span>`).join('')}`
                      :'📌 No prerequisites — can start anytime'}
        </div>
        <div class="prog-track"><div class="prog-fill" style="width:${t.progress}%;background:${bc(t.progress)}"></div></div>
      </div>`;
  }).join('');
}

/* ══════════════════════════════════════════
   CALENDAR — MINI MONTH
══════════════════════════════════════════ */

const MONTHS=['January','February','March','April','May','June',
              'July','August','September','October','November','December'];
const DOWS=['S','M','T','W','T','F','S'];

function miniMonth(delta) {
  calM+=delta;
  if (calM>11){calM=0;calY++;} if (calM<0){calM=11;calY--;}
  renderMiniCal();
}

function renderMiniCal() {
  document.getElementById('mini-title').textContent=`${MONTHS[calM]} ${calY}`;
  const grid=document.getElementById('mini-grid');
  grid.innerHTML='';

  // Day-of-week headers
  DOWS.forEach(d=>{ const h=document.createElement('div'); h.className='mini-dow'; h.textContent=d; grid.appendChild(h); });

  const first=new Date(calY,calM,1);
  const last =new Date(calY,calM+1,0);
  const today=new Date(); today.setHours(0,0,0,0);

  // Blank cells for days before the 1st
  for (let i=0;i<first.getDay();i++) {
    const b=document.createElement('div'); b.className='mini-day other'; grid.appendChild(b);
  }

  // Build set of days that have tasks
  const taskDays=new Set(tasks.filter(t=>t.due).map(t=>t.due));
  const slotDays=new Set(greedySlots.map(s=>dateKey(s.start)));

  for (let d=1;d<=last.getDate();d++) {
    const thisDay=new Date(calY,calM,d); thisDay.setHours(0,0,0,0);
    const key=dateKey(thisDay);
    const isToday=thisDay.getTime()===today.getTime();
    const hasEv=taskDays.has(key)||slotDays.has(key);

    const cell=document.createElement('div');
    cell.className='mini-day'+(isToday?' today':'')+(hasEv&&!isToday?' has-event':'');
    cell.textContent=d;
    cell.onclick=()=>{ weekStart=getMonday(thisDay); renderWeek(); };
    grid.appendChild(cell);
  }

  // Update reminder card
  const upcoming=[...tasks].filter(t=>!t.done&&t.due).sort((a,b)=>new Date(a.due)-new Date(b.due));
  const rc=document.getElementById('reminder-card');
  if (upcoming.length) {
    rc.style.display='block';
    document.getElementById('rc-title').textContent=upcoming[0].name;
    document.getElementById('rc-time').textContent='Due: '+fmtDate(upcoming[0].due);
  } else { rc.style.display='none'; }
}

/* ══════════════════════════════════════════
   CALENDAR — WEEKLY VIEW
   Events appear as colored chips in the correct slot
══════════════════════════════════════════ */

function changeWeek(delta) {
  weekStart=new Date(weekStart.getTime()+delta*7*86400000);
  renderWeek();
}
function jumpToday() { weekStart=getMonday(new Date()); renderWeek(); }

// renderWeek: builds the 7-column × 16-hour grid
function renderWeek() {
  const grid=document.getElementById('week-grid');
  grid.innerHTML='';

  const today=new Date(); today.setHours(0,0,0,0);

  // Build event map: "YYYY-MM-DD-HH" → [events]
  // Each event = { label, cls, startHour, endHour }
  const evMap={}; // key = "dateKey-hour"
  function addEv(dateStr, hour, ev) {
    const k=`${dateStr}-${hour}`;
    if (!evMap[k]) evMap[k]=[];
    evMap[k].push(ev);
  }

  // 1. Task due dates → show on due date at 9 AM if no slot assigned
  const slottedIds=new Set(greedySlots.map(s=>s.taskId));
  if (document.getElementById('flt-slots')?.checked!==false) { // filter checked
    tasks.filter(t=>t.due&&!slottedIds.has(t.id)).forEach(t=>{
      addEv(t.due,9,{
        label:t.name, tag:t.tag,
        time: fmtDate(t.due),
        cls:'ev-'+(isOverdue(t)?'overdue':t.priority)
      });
    });
  }

  // 2. Greedy slots → show at the actual scheduled hour
  if (document.getElementById('flt-slots')?.checked!==false) {
    greedySlots.forEach(s=>{
      const t=tasks.find(x=>x.id===s.taskId); if(!t) return;
      const dk=dateKey(s.start);
      const hr=s.start.getHours();
      addEv(dk,hr,{
        label:'⚡ '+t.name,
        time: `${fmtTime(s.start)}–${fmtTime(s.end)}`,
        cls:'ev-'+(isOverdue(t)?'overdue':t.priority)
      });
    });
  }

  // 3. Knapsack leisure items → show today at free slots after 6 PM
  if (document.getElementById('flt-leisure')?.checked!==false) {
    const todayKey=dateKey(today);
    let lHour=18; // start leisure at 6 PM
    leisure.filter(it=>kSel.has(it.id)).forEach(it=>{
      addEv(todayKey,lHour,{label:it.type+' '+it.name, time:`${lHour}:00 – ${lHour+it.time}:00`, cls:'ev-leisure'});
      lHour+=it.time;
    });
  }

  // ── Day column headers ──
  // Corner cell (top-left of time grid)
  const corner=document.createElement('div');
  corner.className='wg-corner';
  grid.appendChild(corner);

  // Update week title
  const endOfWeek=new Date(weekStart.getTime()+6*86400000);
  document.getElementById('week-title').textContent=
    `${weekStart.toLocaleDateString('en-US',{month:'long',day:'numeric'})} – ${endOfWeek.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}`;

  const dayNames=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  for (let d=0;d<7;d++) {
    const day=new Date(weekStart.getTime()+d*86400000);
    const isToday=day.getTime()===today.getTime();
    const hdr=document.createElement('div');
    hdr.className='wg-day-header'+(isToday?' today-col':'');
    hdr.innerHTML=`<div class="wg-dow">${dayNames[day.getDay()]}</div>
                   <div class="wg-date">${day.getDate()}</div>`;
    grid.appendChild(hdr);
  }

  // ── Time rows (7 AM to 10 PM) ──
  const START_HR=7, END_HR=22;
  for (let h=START_HR;h<END_HR;h++) {
    // Time label cell
    const lbl=document.createElement('div');
    lbl.className='wg-time-label';
    lbl.textContent=h===12?'12 PM':h>12?(h-12)+' PM':h+' AM';
    grid.appendChild(lbl);

    // 7 day cells for this hour row
    for (let d=0;d<7;d++) {
      const day=new Date(weekStart.getTime()+d*86400000);
      const isToday=day.getTime()===today.getTime();
      const cell=document.createElement('div');
      cell.className='wg-cell'+(isToday?' today-col':'');

      const key=`${dateKey(day)}-${h}`;
      const events=evMap[key]||[];
      events.forEach(ev=>{
        const chip=document.createElement('div');
        chip.className=`wg-event ${ev.cls}`;
        chip.innerHTML=`<div class="wg-event-time">${ev.time}</div>
                        <div class="wg-event-title">${ev.label}</div>`;
        cell.appendChild(chip);
      });

      grid.appendChild(cell);
    }
  }
}

